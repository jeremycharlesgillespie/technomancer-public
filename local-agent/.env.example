# =============================================================================
# Technomancer Discord Bot — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- REQUIRED ---

# Discord bot token (from Discord Developer Portal > Bot > Token)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Your Discord username (for admin commands like reloadServer, evolve)
BOT_OWNER=your_discord_username

# --- RECOMMENDED ---

# Anthropic API key for Claude escalation (from console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Discord webhook URL for bot lifecycle notifications (Server Settings > Integrations > Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here

# Path to your Obsidian vault root directory
# VAULT_PATH=C:\Users\YourName\Documents\ObsidianVault

# --- OPTIONAL ---

# Ollama model for chat (default: qwen3.5:9b)
# OLLAMA_MODEL=qwen3.5:9b

# Ollama server URL (default: http://127.0.0.1:11434)
# OLLAMA_HOST=http://127.0.0.1:11434

# Discord channel the bot responds in (default: llm_chat)
# DISCORD_ALLOWED_CHANNEL=llm_chat

# GitHub Pages URL for deployed HTML content
# GITHUB_PAGES_URL=https://yourusername.github.io/technomancer

# Show Claude API cost in responses (default: true)
# CLAUDE_SHOW_COST=true

# Enable GitHub Pages deployment (default: true)
# GITHUB_PAGES_ENABLED=true
